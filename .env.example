# TaskFlow Environment Configuration
# Copy this file to .env and configure your Supabase credentials

# Supabase URL (From your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (From your Supabase Project Settings -> API)
# NEVER put your service_role secret key here!
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Application Configuration
APP_NAME=TaskFlow
APP_ENV=development # development | production
ENABLE_OFFLINE_CACHE=true
ENABLE_LOCAL_NOTIFICATIONS=true
